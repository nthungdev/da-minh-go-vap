GOOGLE_MAPS_EMBED_API_KEY=

PAYLOAD_SECRET=some-secret-key

PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=admin

# Basic auth for private pages (/auth/basic); required by src/middleware.ts.
AUTH_USER=admin
AUTH_PASSWORD=admin

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=da-minh-go-vap
DATABASE_URI=mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@$DATABASE_HOST:$DATABASE_PORT/$DATABASE_NAME?authSource=admin
DB_BACKUP_URL=
DB_RESTORE_URL=

ALLOWED_ORIGINS=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Non-secret placeholders so Firebase initializes in local dev (empty values break client hydration).
# Use real values from the Firebase console for staging/prod.
NEXT_PUBLIC_FIREBASE_API_KEY=local-placeholder-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=local-placeholder
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-0000000000

S3_BUCKET=
