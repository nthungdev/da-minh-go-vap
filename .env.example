PAYLOAD_SECRET=some-secret-key

PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=admin

# Basic auth for private pages (/auth/basic); required by src/middleware.ts.
AUTH_USER=admin
AUTH_PASSWORD=admin

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=da-minh-go-vap
DATABASE_URI=mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@$DATABASE_HOST:$DATABASE_PORT/$DATABASE_NAME?authSource=admin
DB_BACKUP_URL=
DB_RESTORE_URL=

ALLOWED_ORIGINS=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Public CDN host serving the media bucket (Cloudflare R2 custom domain).
NEXT_PUBLIC_MEDIA_CDN_URL=https://cdn-staging.dongdaminhgovap.org

# Set to "true" on non-production deployments to block search engine indexing.
SITE_NOINDEX=false

S3_BUCKET=
