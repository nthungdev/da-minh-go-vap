{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!out",
      "!build",
      "!payload-types.ts",
      "!src/app/(payload)/admin/importMap.js",
      "!next-env.d.ts",
      "!.terraform",
      "!infra/**/.terraform",
      "!.claude",
      "!.agents"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "stylesheet": "./src/app/(app)/globals.css",
    "attributes": ["className", "class", "theme"],
    "mergeFunctions": ["cn", "clsx", "twMerge", "createTheme"],
    "variantFunctions": ["cva"]
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useOptionalChain": "error",
        "useFlatMap": "error",
        "useSimplifiedLogicExpression": "error",
        "noUselessFragments": "error",
        "noUselessTernary": "error",
        "noUselessStringConcat": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "useDefaultParameterLast": "error",
        "useTemplate": "error",
        "useImportType": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "performance": {
        "noAccumulatingSpread": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noExplicitAny": "error"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
